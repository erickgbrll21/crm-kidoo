# Copie para .env na raiz do monorepo. Nunca commite valores reais.

# --- Front-end (Next lê NEXT_PUBLIC_*) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...chave-anon-publica
# Deixe vazio em desenvolvimento local (o Next reescreve /api para a API). Em produção, URL pública da API.
NEXT_PUBLIC_API_URL=

# --- API (Node) ---
NODE_ENV=development
PORT=4000
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-somente-servidor
CORS_ORIGINS=http://localhost:5173
WEBHOOK_SECRET=troque-por-um-segredo-com-24-chars
CRON_SECRET=troque-por-outro-segredo-24-chars
ENABLE_SCHEDULER=true
APP_URL=http://localhost:5173
LOG_LEVEL=info

# Opcionais — só preencha quando a integração existir. Sem isso, a UI mostra "não configurado".
# WHATSAPP_BUSINESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# GOOGLE_CALENDAR_CLIENT_ID=

# Seed de demonstração (opcional)
# SEED_PASSWORD=KidooHub!demo
